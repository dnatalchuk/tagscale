# .env.example
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/tagscale?sslmode=disable
AWS_REGION=us-east-1
# AWS credentials (set these in your shell rather than committing secrets)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Slack configuration
SLACK_TOKEN=xoxb-your-slack-token
SLACK_CHANNEL=#general

# Email configuration
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Background job intervals (in minutes)
DATA_COLLECTION_INTERVAL=60
ANALYSIS_INTERVAL=120

# Logging
LOG_LEVEL=info
